# Base URL of the Intersectia backend (NestJS REST, port 3000).
# The app calls POST {EXPO_PUBLIC_API_URL}/ai/chat.
#
# Android emulator: the host machine is 10.0.2.2 (not localhost).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#
# Physical device on the same Wi-Fi: use your machine's LAN IP, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
